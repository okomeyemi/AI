# Required
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override model
CLAUDE_MODEL=claude-sonnet-5-5
# Public URL of your runner (Termux / ADB listener), e.g. a Tailscale or Cloudflare tunnel
RUNNER_URL=https://your-runner.example.com
# Shared secret between this app and the runner
RUNNER_SECRET=change-me
# Optional: if set, the app's API routes require this key (enter it in the app's Settings)
ACCESS_KEY=change-me-too
